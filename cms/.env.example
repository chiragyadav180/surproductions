# Live site origin, no trailing slash. Used for canonical and social URLs.
# Leave blank until the production domain is confirmed.
VITE_SITE_URL=

# HTTPS endpoint that accepts POST JSON:
# { name, email, phone, organisation, service, message }
# Leave blank until the endpoint exists. The form will not pretend to send.
VITE_CONTACT_ENDPOINT=

# Optional social profile URLs. Leave blank until the accounts are confirmed.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_LINKEDIN=

# CMS administrator, created on first server start when no admin exists yet.
# Set the same three values in Vercel and in Hostinger's environment.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_SECRET=

# Vercel only. GitHub token that can edit this repository, so Publish saves
# the event files Hostinger will use. Hostinger's Node app does not need it.
GITHUB_TOKEN=
PORT=3001
